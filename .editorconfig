# https://editorconfig.org
# 让编辑器在打开文件时就用对缩进，而不是等 cargo fmt 来救。
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,toml}]
indent_size = 2

[*.md]
# Markdown 里行尾两个空格是硬换行，不能删
trim_trailing_whitespace = false

[Makefile]
indent_style = tab
